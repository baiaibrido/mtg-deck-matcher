rules_version = '2';
// Regole del database di Netdeckable: da incollare in Firebase → Firestore Database → Regole → Pubblica.
// Ognuno legge e scrive solo il proprio documento users/<uid>, e solo con i campi previsti.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['collection', 'updatedAt', 'v'])
        && request.resource.data.collection is list
        && request.resource.data.collection.size() <= 20000
        && request.resource.data.updatedAt == request.time;
    }
  }
}
